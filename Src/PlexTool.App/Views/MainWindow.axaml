<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlexTool.App.ViewModels"
        xmlns:views="using:PlexTool.App.Views"
        x:Class="PlexTool.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="{Binding Title}"
        Width="960" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <!-- App-wide keyboard shortcuts (work while the window is focused). Add more here as Tools grow. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+M" Command="{Binding Tools.ScanMoviesCommand}" />
        <KeyBinding Gesture="Ctrl+T" Command="{Binding Tools.ScanShowsCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- Update banner: docked at the very top, shown only when a newer release exists. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsUpdateBannerVisible}"
                Background="#1F6FEB" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Text="{Binding UpdateBannerText}" />
                <Button Grid.Column="1" Margin="8,0,0,0"
                        Content="Install"
                        IsEnabled="{Binding CanInstallUpdate}"
                        Command="{Binding InstallUpdateCommand}" />
                <Button Grid.Column="2" Margin="8,0,0,0"
                        Content="Skip this version"
                        Command="{Binding SkipUpdateCommand}" />
                <Button Grid.Column="3" Margin="8,0,0,0"
                        Content="Later"
                        Command="{Binding DismissUpdateCommand}" />
            </Grid>
        </Border>

        <TabControl Margin="8">
            <TabItem Header="Import">
                <views:ImportView DataContext="{Binding Import}" />
            </TabItem>
            <TabItem Header="Rename / Normalize">
                <views:RenameView DataContext="{Binding Rename}" />
            </TabItem>
            <TabItem Header="Cleanup">
                <views:CleanupView DataContext="{Binding Cleanup}" />
            </TabItem>
            <TabItem Header="Tools">
                <views:ToolsView DataContext="{Binding Tools}" />
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
